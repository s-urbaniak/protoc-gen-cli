			}
			t.AppendHeader(header)
			for _, src := range rows {
				row := make(table.Row, len(fields))
				for j, f := range fields {
					c := {{ fileIdent }}_cell(src.Get(f.Path), "\n")
					if strings.Contains(c, "\n") {
