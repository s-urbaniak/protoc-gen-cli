// printYAML writes each record as one YAML document. "---" separates the
// documents.
func {{ fileIdent }}_printYAML(w io.Writer, _ {{ fileIdent }}_view, next func() ([]byte, error)) error {
	first := true
	for {
		rec, err := next()
		if errors.Is(err, io.EOF) {
			return nil
		}
		if err != nil {
			return err
		}
		if !first {
			if _, err := io.WriteString(w, "---\n"); err != nil {
				return err
			}
		}
		first = false
		doc, err := yaml.JSONToYAML(rec)
		if err != nil {
			return err
		}
		if _, err := w.Write(doc); err != nil {
			return err
		}
	}
}

// cell renders a JSON value as one table cell. Top-level entries stack.
// Deeper levels go inline.
func {{ fileIdent }}_cell(v gjson.Result, sep string) string {
	switch {
	case v.IsArray():
		items := v.Array()
		parts := make([]string, len(items))
		for i, item := range items {
			parts[i] = {{ fileIdent }}_cell(item, ",")
		}
		return strings.Join(parts, sep)
	case v.IsObject():
		var parts []string
		v.ForEach(func(k, val gjson.Result) bool {
			parts = append(parts, k.String()+"="+{{ fileIdent }}_cell(val, ","))
			return true
		})
		return strings.Join(parts, sep)
	default:
		return v.String()
	}
}

