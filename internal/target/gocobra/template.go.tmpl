// printJSON writes each record as one line of JSON.
func {{ fileIdent }}_printJSON(indent bool) func(io.Writer, {{ fileIdent }}_view, func() ([]byte, error)) error {
	return func(w io.Writer, _ {{ fileIdent }}_view, next func() ([]byte, error)) error {
